<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- defaults; Theme.Apply() overwrites these brushes at runtime -->
    <SolidColorBrush x:Key="Convertino.Text" Color="#cdd6f4" />
    <SolidColorBrush x:Key="Convertino.SubText" Color="#a6adc8" />
    <SolidColorBrush x:Key="Convertino.Accent" Color="#cba6f7" />
    <SolidColorBrush x:Key="Convertino.AccentText" Color="#11111b" />
    <SolidColorBrush x:Key="Convertino.Surface" Color="#55313244" />
    <SolidColorBrush x:Key="Convertino.SurfaceHover" Color="#88313244" />
    <SolidColorBrush x:Key="Convertino.Border" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Convertino.Canvas" Color="#47000000" />
    <SolidColorBrush x:Key="Convertino.Window" Color="#1e1e2e" />
    <LinearGradientBrush x:Key="Convertino.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#cba6f7" Offset="0" />
        <GradientStop Color="#f5c2e7" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Convertino.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Convertino.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Convertino.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Convertino.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Convertino.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Convertino.SubText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- plain glass button -->
    <Style x:Key="Convertino.Button" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Convertino.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Convertino.Text}" />
        <Setter Property="Background" Value="{DynamicResource Convertino.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Convertino.Border}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Convertino.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value=".8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value=".45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Convertino.AccentButton" TargetType="Button" BasedOn="{StaticResource Convertino.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Convertino.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource Convertino.AccentGradient}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value=".9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value=".75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value=".4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- borderless icon button -->
    <Style x:Key="Convertino.IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Convertino.SubText}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Convertino.Icons}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Convertino.Surface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value=".35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- selectable chip (RadioButton / ToggleButton) -->
    <Style x:Key="Convertino.Chip" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource Convertino.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Convertino.Text}" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{DynamicResource Convertino.Surface}" BorderBrush="{DynamicResource Convertino.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Convertino.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Convertino.AccentGradient}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource Convertino.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Convertino.RadioChip" TargetType="RadioButton" BasedOn="{StaticResource Convertino.Chip}" />

    <!-- slim slider with gradient fill -->
    <Style x:Key="Convertino.SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="18" Background="Transparent">
                        <Ellipse Fill="White" Stroke="#33000000" StrokeThickness="1">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity=".35" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Convertino.RepeatTransparent" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Convertino.Slider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Convertino.Surface}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Convertino.RepeatTransparent}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Convertino.AccentGradient}" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Convertino.RepeatTransparent}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Convertino.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Convertino.Font}" />
        <Setter Property="Foreground" Value="{DynamicResource Convertino.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Convertino.Window}" BorderBrush="{DynamicResource Convertino.Border}" BorderThickness="1"
                            CornerRadius="7" Padding="9,5">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
